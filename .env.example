# Qatar Life environment configuration
# Never commit real credentials.

NODE_ENV=development
PORT=8787
# In production, set this to the Netlify site origin, e.g. https://qatar-life.netlify.app
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters

# Supabase PostgreSQL connection string.
# Prefer the Supabase pooled connection string for Render.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_SSL=require
DB_POOL_MAX=10
WORLD_BOOTSTRAP=true

# Browser -> Render API URLs. Leave blank for the local Vite proxy.
VITE_API_BASE_URL=
VITE_WS_URL=

# Password reset
PASSWORD_RESET_TTL_MINUTES=30
RETURN_DEV_RESET_TOKEN=true

# Structured logger
LOG_LEVEL=info

# Optional first-admin bootstrap is intentionally not a seed mechanism.
# Create an account, then call the protected one-time bootstrap flow with this token.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-one-time-token

# Future/configurable integrations. Keep external commerce separate from Virtual QAR.
SOKONI_HUB_BASE_URL=
SOKONI_HUB_API_KEY=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
